# =============================================================================
# .gitignore — Universal, language- and platform-independent template
# Add stack-specific rules only when they are needed by the project.
# 1. Local environment files (may contain secrets)
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
!.env.*.example
!.env.*.sample
!.env.*.template
.envrc.local
# 2. Logs and process state files
# 3. Temporary files and editor backups
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~
.#*
\#*#
*.orig
*.rej
# 4. Local tool caches and histories
.tmp/
.temp/
# 5. Personal IDE files (keep shareable project settings trackable)
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
.idea/httpRequests/
.idea/usage.statistics.xml
.vscode/.history/
# 6. Operating system metadata
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
# OPTIONAL RULES — enable only when appropriate for the project.
# These patterns are not universal and may hide legitimate project files.
# /build/
# /dist/
# /out/
# /coverage/
# /tmp/
# /logs/
# /artifacts/
# /reports/
#
# Keep language- and framework-specific patterns in each project's .gitignore
# (e.g., node_modules/, __pycache__/, target/, .gradle/).
# Do not ignore *.lock, *.json, *.db, *.key, or *.pem indiscriminately:
# some of these files may legitimately need to be version-controlled.
# ==============================================================================
# AI development artifacts: skills, context, prompts, and agent-specific files
# Local append-only prompt log and its log-file rotated variants (see AGENTS.md)

# System files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release
/dist
/tmp
/out-tsc
/bazel-out

# Dependency directories
node_modules/
jspm_packages/
package-lock.json

# TypeScript v1 declaration files
typings/

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Obsidian files
.obsidian

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code files
.vscode/
.history/
prettierignore.txt
*.code-workspace
# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# AI development artifacts: skills, context, prompts, instructions, and agent-specific files
.ai/
.ai-context/
.context/
.vibes/
.agents/
.skills/
.cursor/
.cursorrules
.windsurfrules
.opencode/
skills-lock.json

# Local append-only prompt log (mandatory) and its log-file rotated variants (see AGENTS.md)
/AGENTS.log
/AGENTS.log.*
